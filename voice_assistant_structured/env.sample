TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+XXXXXXXXXXX
VERIFIED_TEST_NUMBER=+XXXXXXXXXXX

AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_VERSION=2023-05-15

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx #(only if using OpenAI directly)

# Sarvam AI Text-to-Speech Configuration
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_SPEAKER=manisha  # Female: meera, pavithra, maitreyi, diya, misha, maya, anushka, manisha, vidya, arya | Male: arvind, amol, amartya, neel, vian, arjun, abhilash, karun, hitesh
SARVAM_LANGUAGE=kn-IN  # Hindi (India), also supports en-IN, ta-IN, te-IN, kn-IN, ml-IN, etc.
SARVAM_PITCH=0.0  # Range: -0.75 to 0.75
SARVAM_PACE=1.0   # Range: 0.5 to 2.0
SARVAM_LOUDNESS=1.0  # Range: 0.3 to 3.0
USE_SARVAM_TTS=true  # Set to false to use Amazon Polly instead

# Language Preference and Translation Configuration
USER_LANGUAGE=kn-IN  # User's preferred language (Kannada)
AI_LANGUAGE=en-IN    # Language for AI processing (English)
USE_TRANSLATION=true # Enable automatic translation between user and AI languages

# Speech Timing Configuration
SPEECH_TIMEOUT=auto           # Twilio speech timeout: "auto" or "1"-"60" seconds
WEBSOCKET_SPEECH_TIMEOUT=2.0  # WebSocket silence duration before processing (seconds)
WEBSOCKET_BUFFER_DURATION=30.0 # Maximum WebSocket buffer duration (seconds)

WHATSAPP_SANDBOX_NUMBER=whatsapp:+XXXXXXXXXXXXX
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
# The LLM to use for the Pydantic AI agent
MODEL_CHOICE_GRAPHITI="gpt-4.1-mini"

# Neo4j (knowledge graph) connection details
# Default values are shown here, you'll likely have to adjust the username and password
NEO4J_URI="neo4j://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="admin1234"