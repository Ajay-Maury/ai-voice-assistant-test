# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+XXXXXXXXXXX
VERIFIED_TEST_NUMBER=+XXXXXXXXXXX

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_VERSION=2023-05-15

# Azure TTS + STT
AZURE_TTS_KEY=your_azure_tts_key
AZURE_TTS_REGION=your_azure_tts_region

AZURE_STT_SUBSCRIPTION_KEY=your_azure_stt_subscription_key
AZURE_STT_REGION=your_azure_stt_region

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=whisper-1

# Local Whisper
WHISPER_STT_OFFLINE_MODEL=medium

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_CHAT_TEMPERATURE=0.1

# Redis & WebSocket
REDIS_URL=redis://localhost:6379/0
WEBSOCKET_URL=ws://your-websocket-url/ws
VOICE_ROUTE_URL=https://your-voice-route-url/voice

# Sarvam.ai
SARVAM_SUBSCRIPTION_KEY=your_sarvam_api_key
SARVAM_VOICE=anushka
SARVAM_LANGUAGE=hi-IN
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_STT_MODEL=saarika:v2.5
